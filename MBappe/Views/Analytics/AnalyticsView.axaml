<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:MBappe.ViewModels.Analytics"
             x:Class="MBappe.Views.Analytics.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    Spacing="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Аналитика"
                               Classes="page-title"/>
                    <TextBlock Text="Сводные показатели по персоналу, KPI, обучению и мотивации"
                               Classes="page-subtitle"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ScopeText}"
                               Classes="kicker"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Classes="panel"
                        Padding="12"
                        VerticalAlignment="Center">
                    <WrapPanel>
                        <StackPanel Spacing="4"
                                    Width="140"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Начало периода"
                                       Classes="kicker"/>
                            <TextBox Text="{Binding PeriodStartText}"
                                     Watermark="дд.мм.гггг"/>
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    Width="140"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Конец периода"
                                       Classes="kicker"/>
                            <TextBox Text="{Binding PeriodEndText}"
                                     Watermark="дд.мм.гггг"/>
                        </StackPanel>
                        <Button Content="Сформировать"
                                Classes="primary"
                                Command="{Binding GenerateReportCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0"/>
                    </WrapPanel>
                </Border>
            </Grid>

            <Border Classes="status-banner"
                    Padding="10,8"
                    IsVisible="{Binding HasStatusMessage}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding GeneratedAtText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="18"
                    IsVisible="{Binding HasNoReport}">
                <TextBlock Text="Отчет пока не сформирован."
                           Foreground="{StaticResource MutedTextBrush}"/>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="12">
                <Border Classes="metric-card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Активные сотрудники"
                                   Classes="kicker"/>
                        <TextBlock Text="{Binding ActiveEmployeesText}"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Classes="metric-card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Средний KPI"
                                   Classes="kicker"/>
                        <TextBlock Text="{Binding AverageKpiText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Classes="metric-card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Прогресс обучения"
                                   Classes="kicker"/>
                        <TextBlock Text="{Binding LearningProgressText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Classes="metric-card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="К выплате"
                                   Classes="kicker"/>
                        <TextBlock Text="{Binding PayableBonusText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="panel"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Детализация по направлениям"
                               Classes="section-title"/>

                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,14,0,4">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*">
                            <TextBlock Text="Направление"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="1"
                                       Text="Показатель"
                                       Classes="kicker"
                                       Margin="10,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="Детали"
                                       Classes="kicker"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Персонал"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PersonnelPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PersonnelSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="KPI"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KpiPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding KpiSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Обучение"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LearningPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LearningSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5"
                            Padding="0,10,0,0">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Мотивация"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MotivationPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MotivationSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Text="Сотрудники"
                               Classes="section-title"/>

                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,14,0,4">
                        <Grid ColumnDefinitions="1.45*,1.05*,1.15*,0.85*,0.95*,0.95*,1.35*"
                              ColumnSpacing="12">
                            <TextBlock Text="Сотрудник"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="1"
                                       Text="Отдел"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="2"
                                       Text="Должность"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="3"
                                       Text="KPI"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="4"
                                       Text="Обучение"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="5"
                                       Text="К выплате"
                                       Classes="kicker"/>
                            <TextBlock Grid.Column="6"
                                       Text="Замечания"
                                       Classes="kicker"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding EmployeeRows}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmployeeAnalyticsRowViewModel">
                                <Border Padding="0,12">
                                    <Grid ColumnDefinitions="1.45*,1.05*,1.15*,0.85*,0.95*,0.95*,1.35*"
                                          MinHeight="76"
                                          ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PersonnelNumber}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding Department}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusTitle}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Position}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding AverageKpiText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding KpiDetailsText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding LearningProgressText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LearningDetailsText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding PayableBonusText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PaidBonusText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding ProblemFlagsText}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="18">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Выводы"
                               Classes="section-title"/>
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Insights}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <TextBlock Text="{Binding .}"
                                               Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
