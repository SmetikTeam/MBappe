<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:MBappe.ViewModels.Analytics"
             x:Class="MBappe.Views.Analytics.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32"
                    Spacing="22"
                    MinWidth="980">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="Аналитика"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Сводные показатели по персоналу, KPI, обучению и мотивации"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"/>
                    <TextBlock Text="{Binding ScopeText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Начало периода"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding PeriodStartText}"
                                 Width="132"
                                 Watermark="дд.мм.гггг"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Конец периода"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding PeriodEndText}"
                                 Width="132"
                                 Watermark="дд.мм.гггг"/>
                    </StackPanel>
                    <Button Content="Сформировать"
                            Classes="primary"
                            Command="{Binding GenerateReportCommand}"
                            VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Padding="12"
                    IsVisible="{Binding HasStatusMessage}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding GeneratedAtText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="18"
                    IsVisible="{Binding HasNoReport}">
                <TextBlock Text="Отчет пока не сформирован."
                           Foreground="{StaticResource MutedTextBrush}"/>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Активные сотрудники"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveEmployeesText}"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Средний KPI"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AverageKpiText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Прогресс обучения"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LearningProgressText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="К выплате"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PayableBonusText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Детализация по направлениям"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.05*,1.25*,2.25*"
                          Margin="0,14,0,6">
                        <TextBlock Text="Направление"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Показатель"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                                   Text="Детали"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Персонал"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PersonnelPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PersonnelSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="KPI"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KpiPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding KpiSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Обучение"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LearningPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LearningSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5"
                            Padding="0,10,0,0">
                        <Grid ColumnDefinitions="1.05*,1.25*,2.25*"
                              MinHeight="48">
                            <TextBlock Text="Мотивация"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MotivationPrimaryText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MotivationSecondaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Text="Сотрудники"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.45*,1.05*,1.15*,0.85*,0.95*,0.95*,1.35*"
                          Margin="0,14,0,6">
                        <TextBlock Text="Сотрудник"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Отдел"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                                   Text="Должность"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3"
                                   Text="KPI"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4"
                                   Text="Обучение"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5"
                                   Text="К выплате"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6"
                                   Text="Замечания"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding EmployeeRows}"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmployeeAnalyticsRowViewModel">
                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid ColumnDefinitions="1.45*,1.05*,1.15*,0.85*,0.95*,0.95*,1.35*"
                                          MinHeight="68">
                                        <StackPanel VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PersonnelNumber}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3"
                                                    Margin="10,0">
                                            <TextBlock Text="{Binding Department}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusTitle}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Position}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding AverageKpiText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding KpiDetailsText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Spacing="3"
                                                    Margin="10,0">
                                            <TextBlock Text="{Binding LearningProgressText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LearningDetailsText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5"
                                                    VerticalAlignment="Center"
                                                    Spacing="3"
                                                    Margin="10,0">
                                            <TextBlock Text="{Binding PayableBonusText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PaidBonusText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding ProblemFlagsText}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="18">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Выводы"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Insights}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <TextBlock Text="{Binding .}"
                                               Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
