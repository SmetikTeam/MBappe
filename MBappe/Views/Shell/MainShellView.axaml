<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MBappe.ViewModels.Shell"
             x:Class="MBappe.Views.Shell.MainShellView"
             x:DataType="vm:MainShellViewModel">
    <Grid Background="{StaticResource AppBackgroundBrush}"
          RowDefinitions="Auto,*">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="28,14">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Border Classes="brand-mark">
                        <TextBlock Text="MB"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MBappe"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Управление персоналом"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Border Classes="user-avatar">
                        <TextBlock Text="{Binding UserInitials}"
                                   Foreground="{StaticResource InkBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel MinWidth="170"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}"
                                   Foreground="{StaticResource InkBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentUserRole}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    <Button Content="Выйти"
                            Classes="subtle"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="270,*">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0"
                    Padding="16,14">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Разделы"
                               Classes="kicker"
                               Margin="10,4,0,10"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}"
                             Classes="nav-list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <Border Classes="nav-item">
                                    <Grid ColumnDefinitions="42,*"
                                          MinHeight="42">
                                        <Border Classes="nav-icon"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</UserControl>
