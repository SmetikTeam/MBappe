<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MBappe.ViewModels.Users"
             x:Class="MBappe.Views.Users.UsersView"
             x:DataType="vm:UsersViewModel">
    <Grid RowDefinitions="Auto,*"
          Margin="32">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="10">
            <StackPanel Spacing="6">
                <TextBlock Text="Пользователи"
                           Classes="page-title"/>
                <TextBlock Text="Учетные записи, роли и доступ к системе"
                           Classes="page-subtitle"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Новый пользователь"
                    Classes="primary"
                    Command="{Binding OpenCreateFormCommand}"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="2"
                    Content="Редактировать"
                    Classes="subtle"
                    Command="{Binding OpenEditFormCommand}"
                    IsEnabled="{Binding HasSelectedUser}"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="3"
                    Content="Обновить"
                    Classes="subtle"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,360"
              Margin="0,24,0,0">
            <Border Classes="panel"
                    Margin="0,0,18,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Users}"
                             SelectedItem="{Binding SelectedUser}"
                             Classes="data-list"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserRowViewModel">
                                <Border Padding="12">
                                    <Grid ColumnDefinitions="1.35*,1.1*,1.35*,0.8*"
                                          MinHeight="72">
                                        <StackPanel VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="Пользователь"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FullName}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Login}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="Роль"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RoleTitle}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="3"
                                                    Margin="10,0">
                                            <TextBlock Text="Почта"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Email}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="Статус"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusTitle}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*">
                <Border Classes="panel"
                        Padding="18">
                    <StackPanel Spacing="13">
                        <TextBlock Text="Действия"
                                   Classes="section-title"/>
                        <TextBlock Text="{Binding SelectedUserCaption}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <Button Content="Заблокировать"
                                    Classes="subtle"
                                    Command="{Binding BlockSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedUser}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Разблокировать"
                                    Classes="subtle"
                                    Command="{Binding UnblockSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedUser}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,0">
                    <StackPanel Spacing="18">
                        <Border Classes="panel"
                                Padding="18"
                                IsVisible="{Binding IsEditFormVisible}">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Редактирование"
                                           Classes="section-title"/>
                                <TextBlock Text="{Binding SelectedUserCaption}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="ФИО"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding EditFullName}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Почта"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding EditEmail}"/>
                                </StackPanel>

                                <StackPanel Spacing="6"
                                            IsVisible="{Binding CanChangeRoles}">
                                    <TextBlock Text="Роль"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedEditRole}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RoleOption">
                                                <TextBlock Text="{Binding Title}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Border Classes="error-banner"
                                        Padding="10"
                                        IsVisible="{Binding HasEditFormMessage}">
                                    <TextBlock Text="{Binding EditFormMessage}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">
                                    <Button Content="Сохранить"
                                            Classes="primary"
                                            Command="{Binding SaveSelectedCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Отмена"
                                            Classes="subtle"
                                            Command="{Binding CloseUserFormCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel"
                                Padding="18"
                                IsVisible="{Binding IsCreateFormVisible}">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Новый пользователь"
                                           Classes="section-title"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="ФИО"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding NewFullName}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Логин"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding NewLogin}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Почта"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding NewEmail}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Роль"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRole}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RoleOption">
                                                <TextBlock Text="{Binding Title}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Пароль"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                        <TextBox Text="{Binding NewPassword, Mode=TwoWay}"
                                                 PasswordChar="*"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Повтор"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                        <TextBox Text="{Binding NewConfirmPassword, Mode=TwoWay}"
                                                 PasswordChar="*"/>
                                    </StackPanel>
                                </Grid>

                                <Border Classes="error-banner"
                                        Padding="10"
                                        IsVisible="{Binding HasCreateFormMessage}">
                                    <TextBlock Text="{Binding CreateFormMessage}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">
                                    <Button Content="Создать"
                                            Classes="primary"
                                            Command="{Binding CreateUserCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Отмена"
                                            Classes="subtle"
                                            Command="{Binding CloseUserFormCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
